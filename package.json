{
  "name": "agent-design-system-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first, agent-native toolkit for building and governing design systems.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KinoKo668/hatchkit.git"
  },
  "engines": {
    "node": ">=22.22 <27",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc --build && pnpm --filter @agent-design-system-kit/figma-plugin build:bundle",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm mcp:smoke && pnpm figma:bridge-smoke && pnpm figma:smoke",
    "figma:bridge-smoke": "node packages/mcp-server/scripts/figma-bridge-smoke.mjs",
    "figma:smoke": "node packages/figma-plugin/scripts/bundle-smoke.mjs",
    "format": "prettier --write package.json pnpm-workspace.yaml \"tsconfig*.json\" eslint.config.mjs vitest.config.mts \".github/**/*.{yaml,yml}\" \"design-system/**/*.{json,md}\" \"packages/**/*.{html,json,md,mjs,ts}\"",
    "format:check": "prettier --check package.json pnpm-workspace.yaml \"tsconfig*.json\" eslint.config.mjs vitest.config.mts \".github/**/*.{yaml,yml}\" \"design-system/**/*.{json,md}\" \"packages/**/*.{html,json,md,mjs,ts}\"",
    "hatchkit": "node packages/cli/dist/bin.js",
    "hatchkit:figma-bridge": "node packages/mcp-server/dist/figma-bridge-bin.js",
    "hatchkit:mcp": "node packages/mcp-server/dist/bin.js",
    "lint": "eslint . --max-warnings 0",
    "mcp:smoke": "node packages/mcp-server/scripts/stdio-smoke.mjs",
    "mcp:codex-contract": "pnpm build && node packages/mcp-server/scripts/codex-agent-contract.mjs",
    "test": "vitest run",
    "typecheck": "tsc --build --pretty false && tsc --project tsconfig.test.json --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@figma/plugin-typings": "1.136.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
