      "selections": {
        "appearance": "primary",
        "state": "disabled"
      },
      "bindings": [
        {
          "target": "container.fill",
          "token": "{semantic.color.action-primary-disabled-background}"
        },
        {
          "target": "label.fill",
          "token": "{semantic.color.action-primary-disabled-foreground}"
        },
        {
          "target": "container.opacity",
          "token": "{semantic.number.action-disabled-opacity}"
        }
      ]
    },
    {
      "id": "appearance-secondary/state-default",
      "slotId": "variant/appearance-secondary/state-default",
