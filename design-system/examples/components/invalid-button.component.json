      "bindings": [
        {
          "target": "container.fill",
          "token": "{semantic.color.action-primary-background}"
        },
        {
          "target": "label.fill",
          "token": "{semantic.color.action-primary-foreground}"
        }
      ]
    },
    {
      "id": "appearance-primary/state-disabled",
      "slotId": "variant/appearance-primary/state-disabled",
