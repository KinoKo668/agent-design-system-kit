{
  "schemaVersion": "1.0.0",
  "assetType": "component",
  "projectId": "hatch-demo",
  "assetId": "button",
  "assetVersion": "1.0.0",
  "name": "Button",
  "description": "A deliberately invalid Button contract for stable diagnostics.",
  "profile": "button-v1",
  "componentKind": "component-set",
  "size": "medium",
  "tokenSource": {
    "assetType": "token-set",
