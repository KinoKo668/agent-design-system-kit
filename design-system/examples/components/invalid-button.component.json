      "kind": "variant",
      "figmaName": "Appearance",
      "description": "Appearance with an unsupported option.",
      "defaultOptionId": "tertiary",
      "options": [
        {
          "id": "primary",
          "figmaValue": "Primary",
          "description": "Primary option."
        },
        {
          "id": "secondary",
          "figmaValue": "Secondary",
          "description": "Secondary option."
        },
        {
          "id": "tertiary",
          "figmaValue": "Tertiary",
          "description": "Unsupported option."
        }
      ]
    },
    {
      "id": "state",
      "kind": "variant",
      "figmaName": "State",
      "description": "State property.",
      "defaultOptionId": "default",
      "options": [
        {
          "id": "default",
          "figmaValue": "Default",
          "description": "Default option."
        },
        {
          "id": "disabled",
          "figmaValue": "Disabled",
          "description": "Disabled option."
        }
      ]
    }
  ],
  "sharedBindings": [
