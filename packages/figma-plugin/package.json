{
  "name": "@agent-design-system-kit/figma-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single-writer Figma Plugin package for Agent Design System Kit.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "manifest.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && pnpm run build:bundle",
    "build:bundle": "node ./scripts/build.mjs"
  },
  "dependencies": {
    "@agent-design-system-kit/core": "workspace:*"
  }
}
